// The decoder (inflate.goose) on streams other encoders made, Python's zlib
// and a gzip header built by hand: a zlib stream at level 9, a fixed block,
// a stored one, a dynamic block of 6,800 bytes, a gzip member with every
// optional header field, and two gzip members in a row. Each is decoded
// whole, a byte at a time, and 5 bytes of output a call.
import std;
import compress from "../../";
import check from "../";

let TEXT = "It was the best of times, it was the worst of times, it was the age of wisdom, it was the age of foolishness, it was the epoch of belief, it was the epoch of incredulity.";

let ZLIB9: u8[88] = [
    0x78, 0xda, 0x75, 0xcb, 0xdb, 0x09, 0x80, 0x30, 0x0c, 0x46, 0xe1, 0x55, 0x32, 0x80, 0xb8,
    0x87, 0x63, 0xf4, 0xf2, 0xd7, 0x06, 0x6a, 0x23, 0x4d, 0xa4, 0xb8, 0xbd, 0xf4, 0x49, 0x84,
    0xfa, 0xfc, 0x9d, 0xb3, 0x19, 0x75, 0xa7, 0x64, 0x19, 0xe4, 0xa1, 0x46, 0x92, 0xc8, 0xf8,
    0x80, 0x2e, 0xc4, 0xaf, 0x74, 0x69, 0x7f, 0xe4, 0x76, 0x0c, 0xe8, 0xac, 0x51, 0x8e, 0x99,
    0x24, 0x91, 0xc2, 0x9a, 0x2b, 0xf4, 0x3b, 0xe2, 0x94, 0x90, 0x47, 0xe0, 0x51, 0x18, 0x69,
    0x6e, 0x5c, 0x43, 0x43, 0xbc, 0x0a, 0xdb, 0xbd, 0x3e, 0xc9, 0xad, 0x3b, 0xbb];
let FIXED: u8[11] = [
    0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0xd7, 0x51, 0xc8, 0x40, 0xa2, 0x00];
let STORED: u8[20] = [
    0x01, 0x0f, 0x00, 0xf0, 0xff, 0x73, 0x74, 0x6f, 0x72, 0x65, 0x64, 0x20, 0x61, 0x73, 0x20,
    0x69, 0x74, 0x20, 0x69, 0x73];
let DYNAMIC: u8[124] = [
    0xed, 0xce, 0xdb, 0x09, 0xc3, 0x40, 0x0c, 0x44, 0xd1, 0x56, 0x54, 0x40, 0x48, 0x1f, 0x2e,
    0xc3, 0x0f, 0x6d, 0x56, 0xb0, 0xb6, 0x8c, 0xa5, 0xb0, 0xa4, 0xfb, 0xe0, 0xaf, 0x10, 0x70,
    0x0a, 0x08, 0xdc, 0xef, 0x3b, 0x03, 0x67, 0x48, 0xe9, 0x63, 0x48, 0x56, 0x95, 0x49, 0x23,
    0xc5, 0x8b, 0xa4, 0xad, 0x1a, 0x37, 0xb1, 0x4f, 0xe9, 0x7e, 0xfc, 0x4a, 0xe3, 0x43, 0xcf,
    0xd0, 0x2d, 0x16, 0x5f, 0xaf, 0x4a, 0x71, 0x6f, 0x16, 0x75, 0xd3, 0xf8, 0x3e, 0xea, 0xee,
    0x73, 0x3d, 0x07, 0x93, 0x36, 0xd3, 0x72, 0xdd, 0x6c, 0x9b, 0x0f, 0x5d, 0x9e, 0xcd, 0xf2,
    0x75, 0x1f, 0x90, 0x22, 0x45, 0x8a, 0x14, 0x29, 0x52, 0xa4, 0x48, 0x91, 0x22, 0x45, 0x8a,
    0x14, 0x29, 0x52, 0xa4, 0x48, 0x91, 0x22, 0x45, 0x8a, 0x14, 0x29, 0x52, 0xa4, 0x48, 0x91,
    0xfe, 0xa1, 0xf4, 0x0d];
let GZIP_FIELDS: u8[60] = [
    0x1f, 0x8b, 0x08, 0x1f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x06, 0x00, 0x41, 0x62, 0x02,
    0x00, 0x68, 0x69, 0x6e, 0x61, 0x6d, 0x65, 0x2e, 0x74, 0x78, 0x74, 0x00, 0x61, 0x20, 0x63,
    0x6f, 0x6d, 0x6d, 0x65, 0x6e, 0x74, 0x00, 0x78, 0x4d, 0x4b, 0x2d, 0x4b, 0x2d, 0xaa, 0x54,
    0x48, 0xcb, 0x4c, 0xcd, 0x49, 0x01, 0x00, 0xc4, 0x0e, 0x59, 0xaa, 0x0b, 0x00, 0x00, 0x00];
let GZIP_TWO: u8[67] = [
    0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x4b, 0xcb, 0x2c, 0x2a, 0x2e,
    0x51, 0xc8, 0x4d, 0xcd, 0x4d, 0x4a, 0x2d, 0xd2, 0x51, 0x00, 0x00, 0xde, 0xff, 0x0a, 0x62,
    0x0e, 0x00, 0x00, 0x00, 0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x2b,
    0x4e, 0x4d, 0xce, 0xcf, 0x4b, 0x51, 0xc8, 0x4d, 0xcd, 0x4d, 0x4a, 0x2d, 0x02, 0x00, 0x24,
    0x74, 0xfa, 0x9f, 0x0d, 0x00, 0x00, 0x00];

// Decodes data fed piece bytes at a time (-1: all at once), with most bytes
// of output a call: what it made, and whether the stream ended at data's end.
fn run(format: i64, data: const u8[:], piece: i64, most: i64) -> u8[>..], bool {
    var d = compress::decoder(format);
    var out: u8[>..] = [];
    var at = 0;
    loop {
        let end = if piece < 0 { data.len } else { min(at + piece, data.len) };
        let used, status = compress::decode(d, data[at..end], out, most);
        at += used;
        if status == compress::DECODE_ERROR { return out, false; }
        if status == compress::DECODE_DONE && at == data.len { return out, true; }
        if status == compress::DECODE_MORE && at == data.len { return out, false; }
    }
}

fn each_way(name: const u8[:], format: i64, data: const u8[:], want: const u8[:]) {
    let whole, w = run(format, data, -1, -1);
    let bytes, b = run(format, data, 1, -1);
    let limited, l = run(format, data, -1, 5);
    check::that(str(name, ": ", want.len, " bytes, whole, a byte at a time, and 5 a call"),
                w && whole == want && b && bytes == want && l && limited == want);
}

fn main() {
    each_way("zlib, level 9", compress::ZLIB, ZLIB9, TEXT);
    each_way("a fixed block", compress::RAW, FIXED, "hello, hello, hello");
    each_way("a stored block", compress::RAW, STORED, "stored as it is");
    var forty: u8[>..] = [];
    for i in 40 { forty.append(TEXT); }
    each_way("a dynamic block", compress::RAW, DYNAMIC, forty);
    each_way("gzip with every header field", compress::GZIP, GZIP_FIELDS, "every field");
    each_way("two gzip members", compress::GZIP, GZIP_TWO, "first member, second member");
    var out: u8[>..] = [];
    check::that("decompress, one call", compress::decompress(ZLIB9, out, compress::ZLIB) && out == TEXT);
}
