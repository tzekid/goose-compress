// Streams the decoder (inflate.goose) refuses, each with the reason it
// gives: a reserved block type, a stored length whose complement is wrong, a
// distance past the stream's start, from nothing and by one byte, an
// over-subscribed code, a repeat before any length, length code 286, a wrong
// Adler-32, a preset dictionary, and a gzip CRC and length that don't match.
// Then a stream cut at every byte, which only ever wants more; bytes after a
// zlib stream, which are the caller's; bytes after a gzip member, which
// aren't a member; and a call's output limit, met exactly.
import std;
import compress from "../../";
import check from "../";

let RESERVED: u8[1] = [
    0x07];
let STORED_NLEN: u8[10] = [
    0x01, 0x05, 0x00, 0x00, 0x00, 0x68, 0x65, 0x6c, 0x6c, 0x6f];
let FAR: u8[3] = [
    0x03, 0x02, 0x00];
let FAR_BY_ONE: u8[4] = [
    0x4b, 0x04, 0x42, 0x00];
let OVERSUBSCRIBED: u8[10] = [
    0x05, 0xe0, 0x93, 0x24, 0x49, 0x92, 0x24, 0x49, 0x92, 0x00];
let REPEAT_FIRST: u8[4] = [
    0x05, 0x00, 0x02, 0x24];
let LENGTH_286: u8[2] = [
    0x1b, 0x03];
let ZLIB_BAD_ADLER: u8[88] = [
    0x78, 0x9c, 0x75, 0xcb, 0xdb, 0x09, 0x80, 0x30, 0x0c, 0x46, 0xe1, 0x55, 0x32, 0x80, 0xb8,
    0x87, 0x63, 0xf4, 0xf2, 0xd7, 0x06, 0x6a, 0x23, 0x4d, 0xa4, 0xb8, 0xbd, 0xf4, 0x49, 0x84,
    0xfa, 0xfc, 0x9d, 0xb3, 0x19, 0x75, 0xa7, 0x64, 0x19, 0xe4, 0xa1, 0x46, 0x92, 0xc8, 0xf8,
    0x80, 0x2e, 0xc4, 0xaf, 0x74, 0x69, 0x7f, 0xe4, 0x76, 0x0c, 0xe8, 0xac, 0x51, 0x8e, 0x99,
    0x24, 0x91, 0xc2, 0x9a, 0x2b, 0xf4, 0x3b, 0xe2, 0x94, 0x90, 0x47, 0xe0, 0x51, 0x18, 0x69,
    0x6e, 0x5c, 0x43, 0x43, 0xbc, 0x0a, 0xdb, 0xbd, 0x3e, 0xc9, 0xad, 0x3b, 0xba];
let ZLIB_DICT: u8[6] = [
    0x78, 0xbb, 0x00, 0x00, 0x00, 0x01];
let GZIP_BAD_CRC: u8[27] = [
    0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x4b, 0xce, 0x48, 0x4d, 0xce,
    0x4e, 0x4d, 0x01, 0x00, 0x93, 0xba, 0x03, 0xad, 0x07, 0x00, 0x00, 0x00];
let GZIP_BAD_SIZE: u8[27] = [
    0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x4b, 0xce, 0x48, 0x4d, 0xce,
    0x4e, 0x4d, 0x01, 0x00, 0x83, 0xba, 0x03, 0xad, 0x07, 0x00, 0x00, 0x01];
let ZLIB9: u8[88] = [
    0x78, 0xda, 0x75, 0xcb, 0xdb, 0x09, 0x80, 0x30, 0x0c, 0x46, 0xe1, 0x55, 0x32, 0x80, 0xb8,
    0x87, 0x63, 0xf4, 0xf2, 0xd7, 0x06, 0x6a, 0x23, 0x4d, 0xa4, 0xb8, 0xbd, 0xf4, 0x49, 0x84,
    0xfa, 0xfc, 0x9d, 0xb3, 0x19, 0x75, 0xa7, 0x64, 0x19, 0xe4, 0xa1, 0x46, 0x92, 0xc8, 0xf8,
    0x80, 0x2e, 0xc4, 0xaf, 0x74, 0x69, 0x7f, 0xe4, 0x76, 0x0c, 0xe8, 0xac, 0x51, 0x8e, 0x99,
    0x24, 0x91, 0xc2, 0x9a, 0x2b, 0xf4, 0x3b, 0xe2, 0x94, 0x90, 0x47, 0xe0, 0x51, 0x18, 0x69,
    0x6e, 0x5c, 0x43, 0x43, 0xbc, 0x0a, 0xdb, 0xbd, 0x3e, 0xc9, 0xad, 0x3b, 0xbb];
let GZIP_TWO: u8[67] = [
    0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x4b, 0xcb, 0x2c, 0x2a, 0x2e,
    0x51, 0xc8, 0x4d, 0xcd, 0x4d, 0x4a, 0x2d, 0xd2, 0x51, 0x00, 0x00, 0xde, 0xff, 0x0a, 0x62,
    0x0e, 0x00, 0x00, 0x00, 0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0x2b,
    0x4e, 0x4d, 0xce, 0xcf, 0x4b, 0x51, 0xc8, 0x4d, 0xcd, 0x4d, 0x4a, 0x2d, 0x02, 0x00, 0x24,
    0x74, 0xfa, 0x9f, 0x0d, 0x00, 0x00, 0x00];

fn refused(name: const u8[:], format: i64, data: const u8[:]) {
    var d = compress::decoder(format);
    var out: u8[>..] = [];
    let used, status = compress::decode(d, data, out);
    check::that(str(name, ": ", d.error), status == compress::DECODE_ERROR);
}

fn main() {
    refused("reserved", compress::RAW, RESERVED);
    refused("stored", compress::RAW, STORED_NLEN);
    refused("far", compress::RAW, FAR);
    refused("far by one", compress::RAW, FAR_BY_ONE);
    refused("over-subscribed", compress::RAW, OVERSUBSCRIBED);
    refused("repeat first", compress::RAW, REPEAT_FIRST);
    refused("length 286", compress::RAW, LENGTH_286);
    refused("Adler-32", compress::ZLIB, ZLIB_BAD_ADLER);
    refused("dictionary", compress::ZLIB, ZLIB_DICT);
    refused("CRC", compress::GZIP, GZIP_BAD_CRC);
    refused("length", compress::GZIP, GZIP_BAD_SIZE);

    var wants = true;
    for n in ZLIB9.len {
        var d = compress::decoder(compress::ZLIB);
        var out: u8[>..] = [];
        let used, status = compress::decode(d, ZLIB9[..n], out);
        if status != compress::DECODE_MORE || used != n { wants = false; }
    }
    check::that("every prefix of a zlib stream wants more", wants);

    var tail: u8[>..] = [];
    tail.append(ZLIB9);
    tail.append("xyz");
    var d = compress::decoder(compress::ZLIB);
    var out: u8[>..] = [];
    let used, status = compress::decode(d, tail, out);
    check::that(str("after a zlib stream: done, used ", used, " of ", tail.len),
                status == compress::DECODE_DONE && used == ZLIB9.len);

    var junk: u8[>..] = [];
    junk.append(GZIP_TWO[..34]);
    junk.append("junk");
    var g = compress::decoder(compress::GZIP);
    out.clear();
    let gu, gs = compress::decode(g, junk, out);
    let ju, js = compress::decode(g, junk[gu..], out);
    check::that(str("after a gzip member: done at ", gu, ", then ", g.error),
                gs == compress::DECODE_DONE && gu == 34 && js == compress::DECODE_ERROR && out == "first member, ");

    var l = compress::decoder(compress::ZLIB);
    out.clear();
    let lu, ls = compress::decode(l, ZLIB9, out, 10);
    check::that(str("a limit of 10: ", out.len, " bytes, full"), ls == compress::DECODE_FULL && out.len == 10);
}
